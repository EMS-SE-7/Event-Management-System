{
  "name": "server",
  "version": "1.0.0",
  "description": "",
  "main": "src/index.js",
  "scripts": {
    "dev": "nodemon src/index.js",
    "start": "node src/index.js",
    "test": "jest",
    "seed": "node src/scripts/seedUsers.js",
    "seed:events": "node src/scripts/seedEvents.js",
    "test:ci": "jest --ci --coverage --json --outputFile=coverage/test-results.json",
    "test:unit": "jest --selectProjects unit",
    "test:integration": "jest --selectProjects integration"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "dependencies": {
    "bcryptjs": "^3.0.3",
    "cors": "^2.8.6",
    "dotenv": "^18.0.9",
    "express": "^5.3.0",
    "jsonwebtoken": "^9.0.3",
    "mongoose": "^9.11.4"
  },
  "devDependencies": {
    "jest": "^30.5.2",
    "mongodb-memory-server": "^11.3.0",
    "nodemon": "^3.1.14",
    "supertest": "^7.3.1"
  },
  "jest": {
    "collectCoverageFrom": [
      "src/**/*.js",
      "!src/**/*.test.js",
      "!src/scripts/**"
    ],
    "coverageReporters": [
      "text",
      "text-summary",
      "html",
      "json",
      "json-summary",
      "lcovonly"
    ],
    "projects": [
      {
        "displayName": "unit",
        "testEnvironment": "node",
        "testMatch": [
          "<rootDir>/tests/unit/**/*.test.js",
          "<rootDir>/tests/eventStatus.test.js",
          "<rootDir>/tests/event.model.test.js",
          "<rootDir>/tests/serveClient.test.js"
        ]
      },
      {
        "displayName": "integration",
        "testEnvironment": "node",
        "testMatch": [
          "<rootDir>/tests/integration/**/*.test.js",
          "<rootDir>/tests/events.*.test.js",
          "<rootDir>/tests/registrations*.test.js",
          "<rootDir>/src/**/*.test.js"
        ]
      }
    ]
  },
  "engines": {
    "node": ">=20.19"
  }
}
