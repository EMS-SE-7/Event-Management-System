# Dev proxy target for /api (server PORT from server/.env)
VITE_API_PROXY=http://localhost:5000
# Optional: absolute API base URL for builds that are not served behind the proxy
# VITE_API_URL=https://api.example.com/api
# Optional: VITE_USE_MOCK=true shows sample events instead of calling the server
# VITE_USE_MOCK=true
